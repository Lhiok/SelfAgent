/* SelfAgent — 参照 Cursor Agents 浅色三栏窗口 */

* {
    outline: none;
}

QMainWindow, QDialog {
    background: #F7F7F5;
    color: #1A1A1A;
    font-family: "Segoe UI", "Microsoft YaHei UI", sans-serif;
    font-size: 13px;
}

QToolTip {
    background: #FFFFFF;
    color: #1A1A1A;
    border: 1px solid #E5E5E2;
    padding: 4px 8px;
}

QSplitter::handle {
    background: #E8E8E5;
    width: 1px;
}

QSplitter::handle:hover {
    background: #D0D0CC;
}

/* ——— Panels ——— */
#Sidebar {
    background: #F0F0EE;
    border-right: 1px solid #E5E5E2;
}

#ChatPane {
    background: #F7F7F5;
}

#Inspector {
    background: #FFFFFF;
    border-left: 1px solid #E5E5E2;
}

#TopBar {
    background: #F7F7F5;
    border-bottom: 1px solid #E5E5E2;
    min-height: 44px;
}

#BrandLabel {
    font-size: 12px;
    font-weight: 600;
    color: #6B6B6B;
    padding-right: 10px;
}

#SessionTitle {
    font-size: 14px;
    font-weight: 600;
    color: #1A1A1A;
}

#WorkdirLabel {
    color: #8A8A8A;
    font-size: 11px;
    padding: 0 8px;
}

#PanelCaption {
    font-size: 11px;
    font-weight: 600;
    color: #8A8A8A;
}

#ChatHeader {
    background: #F7F7F5;
    border-bottom: 1px solid #E5E5E2;
}

/* ——— Sidebar list (custom rows) ——— */
#SidebarScroll, #SidebarList {
    background: transparent;
    border: none;
}

#WorkspaceHeader {
    background: transparent;
    border-radius: 8px;
}

#WorkspaceHeader:hover {
    background: #E6E6E3;
}

#FolderIcon {
    font-size: 15px;
    padding-top: 1px;
}

#WorkspaceName {
    font-size: 13px;
    font-weight: 600;
    color: #1A1A1A;
}

#WorkspacePath {
    font-size: 10px;
    color: #8A8A8A;
}

#WorkspacePlus {
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    border: none;
    border-radius: 6px;
    color: #6B6B6B;
    font-size: 16px;
    font-weight: 600;
    background: transparent;
}

#WorkspacePlus:hover {
    background: #DCDCD8;
    color: #1A1A1A;
}

#SessionList {
    background: transparent;
}

#SessionRow {
    background: transparent;
    border: none;
    border-radius: 8px;
    min-height: 28px;
    max-height: 32px;
}

#SessionRow:hover {
    background: #E6E6E3;
}

#SessionRow[selected="true"] {
    background: #E0E0DC;
}

#SessionRow[selected="true"]:hover {
    background: #D8D8D4;
}

#SessionTitleLabel {
    font-size: 12.5px;
    color: #2A2A2A;
    background: transparent;
}

#SessionRow[selected="true"] #SessionTitleLabel {
    color: #1A1A1A;
    font-weight: 500;
}

#ArchiveTag {
    font-size: 10px;
    color: #8A8A8A;
    padding: 1px 6px;
    background: #E8E8E5;
    border-radius: 6px;
}

#StarButton {
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    border: none;
    background: transparent;
    font-size: 13px;
    color: #B0B0B0;
    padding: 0;
}

#StarButton:hover {
    color: #E6A817;
}

#StarButton[starred="true"] {
    color: #E6A817;
}

/* ——— Buttons ——— */
QPushButton {
    background: #FFFFFF;
    color: #2A2A2A;
    border: 1px solid #E0E0DC;
    border-radius: 8px;
    padding: 5px 12px;
    min-height: 28px;
}

QPushButton:hover {
    background: #F0F0EE;
    border-color: #D0D0CC;
}

QPushButton:pressed {
    background: #E6E6E3;
}

QPushButton:disabled {
    color: #B0B0B0;
    background: #F5F5F3;
    border-color: #EBEBE8;
}

QPushButton#PrimaryButton {
    background: #1A1A1A;
    color: #FFFFFF;
    border: 1px solid #1A1A1A;
    font-weight: 600;
}

QPushButton#PrimaryButton:hover {
    background: #333333;
}

QPushButton#PrimaryButton:pressed {
    background: #000000;
}

QPushButton#PrimaryButton:disabled {
    background: #C8C8C4;
    border-color: #C8C8C4;
    color: #F5F5F3;
}

QPushButton#GhostButton {
    background: transparent;
    border: 1px solid transparent;
    color: #6B6B6B;
}

QPushButton#GhostButton:hover {
    background: #EBEBE8;
    color: #1A1A1A;
}

QPushButton#GhostButton:checked {
    background: #E0E0DC;
    color: #1A1A1A;
}

QPushButton#DangerButton {
    background: transparent;
    color: #C44;
    border: 1px solid transparent;
}

QPushButton#DangerButton:hover {
    background: #FCEBEB;
    border-color: #F0D0D0;
}

QPushButton#IconButton {
    min-width: 30px;
    max-width: 34px;
    padding: 2px;
    font-size: 16px;
    font-weight: 500;
    color: #6B6B6B;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
}

QPushButton#IconButton:hover {
    background: #E6E6E3;
    color: #1A1A1A;
}

QComboBox {
    background: #FFFFFF;
    border: 1px solid #E0E0DC;
    border-radius: 8px;
    padding: 4px 10px;
    min-height: 26px;
    min-width: 78px;
    color: #2A2A2A;
}

QComboBox:hover {
    border-color: #C8C8C4;
}

QComboBox:focus {
    border-color: #1A1A1A;
}

QComboBox::drop-down {
    border: none;
    width: 18px;
}

QComboBox QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #E0E0DC;
    color: #2A2A2A;
    selection-background-color: #E6E6E3;
    selection-color: #1A1A1A;
    outline: none;
}

QTextEdit, QPlainTextEdit, QLineEdit {
    background: #FFFFFF;
    border: 1px solid #E0E0DC;
    border-radius: 10px;
    padding: 8px 10px;
    color: #1A1A1A;
    selection-background-color: #D8E6FF;
    selection-color: #1A1A1A;
}

QTextEdit:focus, QPlainTextEdit:focus, QLineEdit:focus {
    border: 1px solid #B8B8B4;
}

QTextBrowser#ChatView {
    background: #F7F7F5;
    border: none;
    padding: 0;
    color: #1A1A1A;
}

QTextBrowser#InspectorView {
    background: #FFFFFF;
    color: #1A1A1A;
    border: 1px solid #EBEBE8;
    border-radius: 10px;
    font-family: "Cascadia Mono", "Consolas", "Sarasa Mono SC", monospace;
    font-size: 12px;
    padding: 0;
}

/* Composer — 浅色圆角输入条 */
#ComposerDock {
    background: #F7F7F5;
    border-top: none;
}

#ComposerBox {
    background: #FFFFFF;
    border: 1px solid #E0E0DC;
    border-radius: 16px;
}

#ComposerBox:focus-within {
    border-color: #C0C0BC;
}

#ComposerBox QTextEdit {
    border: none;
    background: transparent;
    padding: 4px 2px 2px 2px;
    color: #1A1A1A;
}

/* Composer 内模式胶囊（参照 Cursor） */
QToolButton#ModePill {
    background: #2C2C2C;
    border: 1px solid #3A3A3A;
    border-radius: 10px;
    padding: 1px 10px;
    color: #F2F2F2;
    font-size: 11px;
    font-weight: 600;
    min-height: 20px;
    max-height: 22px;
}

QToolButton#ModePill:hover {
    background: #3A3A3A;
    border-color: #4A4A4A;
}

QToolButton#ModePill:disabled {
    background: #E8E8E5;
    border-color: #E0E0DC;
    color: #A0A0A0;
}

QToolButton#ModePill::menu-indicator {
    image: none;
    width: 0;
}

/* Agent/Plan 上拉菜单：窄、椭圆角 */
QMenu#ModeMenu {
    background: #2A2A2A;
    border: 1px solid #3C3C3C;
    border-radius: 14px;
    padding: 4px;
    color: #F0F0F0;
}

QMenu#ModeMenu::item {
    padding: 6px 10px;
    border-radius: 10px;
    margin: 1px 0;
    background: transparent;
    color: #F0F0F0;
    font-size: 12px;
}

QMenu#ModeMenu::item:selected {
    background: #3A3A3A;
}

QMenu#ModeMenu::item:checked {
    background: #333333;
}

QMenu#ModeMenu::indicator {
    width: 0;
    height: 0;
}

QMenu#ModeMenu::right-arrow {
    width: 0;
}

QPushButton#SendCircle {
    background: #1A1A1A;
    color: #FFFFFF;
    border: none;
    border-radius: 14px;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
    padding: 0;
    font-size: 14px;
    font-weight: 700;
}

QPushButton#SendCircle:hover {
    background: #333333;
}

QPushButton#SendCircle:disabled {
    background: #C8C8C4;
    color: #F5F5F3;
}

#StatusLabel {
    color: #8A8A8A;
    font-size: 11px;
    padding: 2px 4px 0 4px;
}

#TodoBanner {
    background: #FFFFFF;
    border: 1px solid #E5E5E2;
    border-radius: 10px;
}

#TodoBanner QLabel {
    color: #6B6B6B;
    font-size: 12px;
}

QProgressBar {
    background: #E8E8E5;
    border: none;
    border-radius: 2px;
    height: 3px;
    max-height: 3px;
    color: transparent;
}

QProgressBar::chunk {
    background: #1A1A1A;
    border-radius: 2px;
}

#ActionStrip {
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #D0D0CC;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #B8B8B4;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QGroupBox {
    border: 1px solid #E5E5E2;
    border-radius: 10px;
    margin-top: 10px;
    padding: 12px 10px 10px 10px;
    background: #FFFFFF;
    font-weight: 600;
    color: #2A2A2A;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
    color: #6B6B6B;
}

QRadioButton, QCheckBox {
    color: #2A2A2A;
    spacing: 8px;
}

QMenu {
    background: #FFFFFF;
    border: 1px solid #E5E5E2;
    color: #1A1A1A;
}

QMenu::item {
    padding: 6px 24px;
}

QMenu::item:selected {
    background: #EBEBE8;
}

QMessageBox {
    background: #FFFFFF;
}
