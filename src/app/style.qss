/* SelfAgent — Cursor / Codex inspired dark client */

* {
    outline: none;
}

QMainWindow, QDialog {
    background: #181818;
    color: #CCCCCC;
    font-family: "Segoe UI", "Microsoft YaHei UI", sans-serif;
    font-size: 13px;
}

QToolTip {
    background: #252526;
    color: #CCCCCC;
    border: 1px solid #454545;
    padding: 4px 8px;
}

QSplitter::handle {
    background: #2B2B2B;
    width: 1px;
}

QSplitter::handle:hover {
    background: #3794FF;
}

/* ——— Panels ——— */
#Sidebar {
    background: #141414;
    border-right: 1px solid #2B2B2B;
}

#ChatPane {
    background: #181818;
}

#Inspector {
    background: #141414;
    border-left: 1px solid #2B2B2B;
}

#TopBar {
    background: #141414;
    border-bottom: 1px solid #2B2B2B;
    min-height: 40px;
}

#BrandLabel {
    font-size: 13px;
    font-weight: 600;
    color: #E8E8E8;
    letter-spacing: 0.2px;
    padding-right: 14px;
}

#SessionTitle {
    font-size: 13px;
    font-weight: 500;
    color: #E0E0E0;
}

#WorkdirLabel {
    color: #6E6E6E;
    font-size: 11px;
    padding: 0 8px;
}

#PanelCaption {
    font-size: 10px;
    font-weight: 600;
    color: #6E6E6E;
    letter-spacing: 0.6px;
}

/* ——— Tree (session list) ——— */
QTreeWidget {
    background: transparent;
    border: none;
    color: #CCCCCC;
    padding: 2px 4px;
}

QTreeWidget::item {
    min-height: 26px;
    padding: 3px 8px;
    border-radius: 4px;
    margin: 1px 0;
}

QTreeWidget::item:hover {
    background: #2A2A2A;
}

QTreeWidget::item:selected {
    background: #2F2F2F;
    color: #FFFFFF;
    border-left: 2px solid #3794FF;
}

QTreeWidget::branch {
    background: transparent;
}

QTreeWidget::branch:has-children:!has-siblings:closed,
QTreeWidget::branch:closed:has-children:has-siblings {
    border-image: none;
    image: none;
}

/* ——— Buttons ——— */
QPushButton {
    background: #2A2A2A;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 5px;
    padding: 5px 12px;
    min-height: 26px;
}

QPushButton:hover {
    background: #323232;
    border-color: #4A4A4A;
    color: #FFFFFF;
}

QPushButton:pressed {
    background: #1E1E1E;
}

QPushButton:disabled {
    color: #5A5A5A;
    background: #222222;
    border-color: #2B2B2B;
}

QPushButton#PrimaryButton {
    background: #0E639C;
    color: #FFFFFF;
    border: 1px solid #1177BB;
    font-weight: 550;
}

QPushButton#PrimaryButton:hover {
    background: #1177BB;
}

QPushButton#PrimaryButton:pressed {
    background: #0B507A;
}

QPushButton#PrimaryButton:disabled {
    background: #264F78;
    border-color: #264F78;
    color: #8AABCC;
}

QPushButton#GhostButton {
    background: transparent;
    border: 1px solid transparent;
    color: #9D9D9D;
}

QPushButton#GhostButton:hover {
    background: #2A2A2A;
    color: #E0E0E0;
}

QPushButton#GhostButton:checked {
    background: #2A2A2A;
    color: #FFFFFF;
    border: 1px solid #3C3C3C;
}

QPushButton#DangerButton {
    background: transparent;
    color: #F48771;
    border: 1px solid #5A3A34;
}

QPushButton#DangerButton:hover {
    background: #3A2220;
    border-color: #F48771;
}

QPushButton#IconButton {
    min-width: 28px;
    max-width: 32px;
    padding: 2px;
    font-size: 15px;
    font-weight: 500;
    color: #9D9D9D;
    background: transparent;
    border: 1px solid transparent;
}

QPushButton#IconButton:hover {
    background: #2A2A2A;
    color: #FFFFFF;
}

/* Mode / detail combos — compact toolbar controls */
QComboBox {
    background: #2A2A2A;
    border: 1px solid #3C3C3C;
    border-radius: 5px;
    padding: 3px 8px;
    min-height: 24px;
    min-width: 78px;
    color: #CCCCCC;
}

QComboBox:hover {
    border-color: #4A4A4A;
}

QComboBox:focus {
    border-color: #3794FF;
}

QComboBox::drop-down {
    border: none;
    width: 18px;
}

QComboBox QAbstractItemView {
    background: #252526;
    border: 1px solid #3C3C3C;
    color: #CCCCCC;
    selection-background-color: #094771;
    selection-color: #FFFFFF;
    outline: none;
}

/* Inputs */
QTextEdit, QPlainTextEdit, QLineEdit {
    background: #1E1E1E;
    border: 1px solid #3C3C3C;
    border-radius: 6px;
    padding: 8px 10px;
    color: #D4D4D4;
    selection-background-color: #264F78;
    selection-color: #FFFFFF;
}

QTextEdit:focus, QPlainTextEdit:focus, QLineEdit:focus {
    border: 1px solid #3794FF;
}

QTextBrowser#ChatView {
    background: #181818;
    border: none;
    padding: 4px 0;
    color: #D4D4D4;
}

/* Diff / code panel — editor surface */
QPlainTextEdit#InspectorView {
    background: #1E1E1E;
    color: #D4D4D4;
    border: 1px solid #2B2B2B;
    border-radius: 6px;
    font-family: "Cascadia Mono", "Consolas", "Sarasa Mono SC", monospace;
    font-size: 12px;
    padding: 10px 12px;
}

/* Composer — Cursor-style bottom dock */
#ComposerDock {
    background: #141414;
    border-top: 1px solid #2B2B2B;
}

#ComposerBox {
    background: #1E1E1E;
    border: 1px solid #3C3C3C;
    border-radius: 8px;
}

#ComposerBox:focus-within {
    border-color: #3794FF;
}

#ComposerBox QTextEdit {
    border: none;
    background: transparent;
    padding: 10px 12px;
    color: #E0E0E0;
}

#StatusLabel {
    color: #6E6E6E;
    font-size: 11px;
    padding: 2px 2px 0 2px;
}

#TodoBanner {
    background: #1E1E1E;
    border: 1px solid #2B2B2B;
    border-radius: 6px;
}

#TodoBanner QLabel {
    color: #9D9D9D;
    font-size: 11px;
}

QProgressBar {
    background: #2B2B2B;
    border: none;
    border-radius: 2px;
    height: 3px;
    text-align: center;
    color: transparent;
    max-height: 3px;
}

QProgressBar::chunk {
    background: #3794FF;
    border-radius: 2px;
}

#ActionStrip {
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #424242;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #4E4E4E;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    height: 8px;
    background: transparent;
}

QScrollBar::handle:horizontal {
    background: #424242;
    border-radius: 4px;
}

QGroupBox {
    border: 1px solid #3C3C3C;
    border-radius: 6px;
    margin-top: 10px;
    padding: 12px 10px 10px 10px;
    background: #1E1E1E;
    font-weight: 600;
    color: #CCCCCC;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #9D9D9D;
}

QRadioButton, QCheckBox {
    color: #CCCCCC;
    spacing: 8px;
}

QRadioButton::indicator, QCheckBox::indicator {
    width: 14px;
    height: 14px;
}

QDialogButtonBox QPushButton {
    min-width: 72px;
}

QMenu {
    background: #252526;
    border: 1px solid #3C3C3C;
    color: #CCCCCC;
}

QMenu::item {
    padding: 6px 24px;
}

QMenu::item:selected {
    background: #094771;
}

QMessageBox {
    background: #252526;
}
