/* SelfAgent — 参照 Cursor Agents 浅色三栏窗口 */

* {
    outline: none;
    font-family: "Cascadia Code", "Cascadia Mono", "Sarasa Mono SC", Consolas, "Microsoft YaHei UI", monospace;
}

QMainWindow, QDialog {
    background: #F7F7F5;
    color: #1A1A1A;
    font-family: "Cascadia Code", "Cascadia Mono", "Sarasa Mono SC", Consolas, "Microsoft YaHei UI", monospace;
    font-size: 13px;
}

QToolTip {
    background: #FFFFFF;
    color: #1A1A1A;
    border: 1px solid #E5E5E2;
    padding: 4px 8px;
}

QSplitter::handle {
    background: #E8E8E5;
    width: 1px;
}

QSplitter::handle:hover {
    background: #D0D0CC;
}

/* ——— Panels ——— */
#Sidebar {
    background: #F0F0EE;
    border-right: 1px solid #E5E5E2;
}

#ChatPane {
    background: #F7F7F5;
}

#Inspector {
    background: #FFFFFF;
    border-left: 1px solid #E5E5E2;
}

#TopBar {
    background: #F7F7F5;
    border-bottom: 1px solid #E5E5E2;
    min-height: 44px;
}

#BrandLabel {
    font-size: 12px;
    font-weight: 600;
    color: #6B6B6B;
    padding-right: 10px;
}

#SessionTitle {
    font-size: 14px;
    font-weight: 600;
    color: #1A1A1A;
}

#WorkdirLabel {
    color: #8A8A8A;
    font-size: 11px;
    padding: 0 8px;
}

#PanelCaption {
    font-size: 11px;
    font-weight: 600;
    color: #8A8A8A;
}

#ChatHeader {
    background: #F7F7F5;
    border-bottom: 1px solid #E5E5E2;
}

/* ——— Sidebar list (custom rows) ——— */
#SidebarScroll, #SidebarList {
    background: transparent;
    border: none;
}

#WorkspaceHeader {
    background: transparent;
    border-radius: 8px;
}

#WorkspaceHeader:hover {
    background: #E6E6E3;
}

#FolderIcon {
    font-size: 15px;
    padding-top: 1px;
}

#WorkspaceName {
    font-size: 13px;
    font-weight: 600;
    color: #1A1A1A;
}

#WorkspacePath {
    font-size: 10px;
    color: #8A8A8A;
}

#WorkspacePlus {
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    border: none;
    border-radius: 6px;
    color: #6B6B6B;
    font-size: 16px;
    font-weight: 600;
    background: transparent;
}

#WorkspacePlus:hover {
    background: #DCDCD8;
    color: #1A1A1A;
}

#SessionList {
    background: transparent;
}

#SessionRow {
    background: transparent;
    border: none;
    border-radius: 8px;
    min-height: 28px;
    max-height: 32px;
}

#SessionRow:hover {
    background: #E6E6E3;
}

#SessionRow[selected="true"] {
    background: #E0E0DC;
}

#SessionRow[selected="true"]:hover {
    background: #D8D8D4;
}

#SessionTitleLabel {
    font-size: 12.5px;
    color: #2A2A2A;
    background: transparent;
}

#SessionRow[selected="true"] #SessionTitleLabel {
    color: #1A1A1A;
    font-weight: 500;
}

#ArchiveTag {
    font-size: 10px;
    color: #8A8A8A;
    padding: 1px 6px;
    background: #E8E8E5;
    border-radius: 6px;
}

#StarButton {
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    border: none;
    background: transparent;
    font-size: 13px;
    color: #B0B0B0;
    padding: 0;
}

#StarButton:hover {
    color: #E6A817;
}

#StarButton[starred="true"] {
    color: #E6A817;
}

/* ——— Buttons ——— */
QPushButton {
    background: #FFFFFF;
    color: #2A2A2A;
    border: 1px solid #E0E0DC;
    border-radius: 8px;
    padding: 5px 12px;
    min-height: 28px;
}

QPushButton:hover {
    background: #F0F0EE;
    border-color: #D0D0CC;
}

QPushButton:pressed {
    background: #E6E6E3;
}

QPushButton:disabled {
    color: #B0B0B0;
    background: #F5F5F3;
    border-color: #EBEBE8;
}

QPushButton#PrimaryButton {
    background: #1A1A1A;
    color: #FFFFFF;
    border: 1px solid #1A1A1A;
    font-weight: 600;
}

QPushButton#PrimaryButton:hover {
    background: #333333;
}

QPushButton#PrimaryButton:pressed {
    background: #000000;
}

QPushButton#PrimaryButton:disabled {
    background: #C8C8C4;
    border-color: #C8C8C4;
    color: #F5F5F3;
}

QPushButton#GhostButton {
    background: transparent;
    border: 1px solid transparent;
    color: #6B6B6B;
}

QPushButton#GhostButton:hover {
    background: #EBEBE8;
    color: #1A1A1A;
}

QPushButton#GhostButton:checked {
    background: #E0E0DC;
    color: #1A1A1A;
}

QPushButton#OpenFileButton {
    background: #EBEBE8;
    border: none;
    border-radius: 10px;
    color: #3A3A36;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 600;
    min-height: 26px;
}

QPushButton#OpenFileButton:hover {
    background: #E0E0DC;
    color: #1A1A1A;
}

QPushButton#OpenFileButton:pressed {
    background: #D4D4D0;
}

QPushButton#OpenFileButton:disabled {
    background: #F0F0EE;
    color: #B0B0AC;
}

QPushButton#DangerButton {
    background: transparent;
    color: #C44;
    border: 1px solid transparent;
}

QPushButton#DangerButton:hover {
    background: #FCEBEB;
    border-color: #F0D0D0;
}

QPushButton#IconButton {
    min-width: 30px;
    max-width: 34px;
    padding: 2px;
    font-size: 16px;
    font-weight: 500;
    color: #6B6B6B;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
}

QPushButton#IconButton:hover {
    background: #E6E6E3;
    color: #1A1A1A;
}

QComboBox {
    background: #FFFFFF;
    border: 1px solid #E0E0DC;
    border-radius: 8px;
    padding: 4px 10px;
    min-height: 26px;
    min-width: 78px;
    color: #2A2A2A;
}

QComboBox:hover {
    border-color: #C8C8C4;
}

QComboBox:focus {
    border-color: #1A1A1A;
}

QComboBox::drop-down {
    border: none;
    width: 18px;
}

QComboBox QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #E0E0DC;
    color: #2A2A2A;
    selection-background-color: #E6E6E3;
    selection-color: #1A1A1A;
    outline: none;
}

QTextEdit, QPlainTextEdit, QLineEdit {
    background: #FFFFFF;
    border: 1px solid #E0E0DC;
    border-radius: 10px;
    padding: 8px 10px;
    color: #1A1A1A;
    selection-background-color: #D8E6FF;
    selection-color: #1A1A1A;
}

QTextEdit:focus, QPlainTextEdit:focus, QLineEdit:focus {
    border: 1px solid #B8B8B4;
}

QScrollArea#ChatStream {
    background: #F7F7F5;
    border: none;
}

QWidget#ChatStreamHost {
    background: #F7F7F5;
}

/* 底色由 RoundedBubble 自绘，这里只清默认方底 */
QFrame#UserBubble,
QFrame#AssistantBubble,
QFrame#ErrorBubble,
QFrame#MdCodeBlock {
    background: transparent;
    border: none;
}

QFrame#MdCodeHead {
    background: transparent;
    border: none;
}

QWidget#MdCodeBody {
    background: transparent;
    border: none;
}

QFrame#MdHrLine {
    background: #E0E0DC;
    border: none;
    max-height: 1px;
    min-height: 1px;
}

QLabel#MdCodeLang {
    background: transparent;
    border: none;
    color: #8A8A86;
    font-size: 10px;
    font-weight: 600;
    padding: 0;
}

QLabel#MdCodeText {
    background: transparent;
    border: none;
    color: #3A3A36;
    font-size: 12px;
    padding: 0;
    line-height: 1.12;
}

QLabel#MdCodeAction {
    background: #D4D4CE;
    color: #3A3A36;
    border: 1px solid #C8C8C2;
    border-radius: 4px;
    padding: 0 8px;
    font-size: 10px;
    min-height: 18px;
    max-height: 18px;
}

QLabel#MdCodeOutput {
    background: #DEDED8;
    color: #5A5A56;
    border: none;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 11px;
    margin-top: 2px;
}

QLabel#UserBubbleText {
    background: transparent;
    border: none;
    color: #17362C;
    font-size: 13px;
    padding: 0;
    line-height: 1.15;
}

QLabel#AssistantBubbleText {
    background: transparent;
    border: none;
    color: #3A3A36;
    font-size: 13px;
    padding: 0;
    margin: 0;
}

QLabel#ErrorBubbleText {
    background: transparent;
    border: none;
    color: #6B3030;
    font-size: 13px;
    padding: 0;
    margin: 0;
}

QLabel#ChatHtml {
    background: transparent;
    border: none;
    color: #1A1A1A;
    font-size: 13px;
}

QFrame#ChangesBlock {
    background: transparent;
    border: none;
}

QFrame#ChangesBlock:hover QLabel#ChangesHead {
    color: #3B6EF5;
}

QLabel#ChangesHead {
    background: transparent;
    border: none;
    color: #6B6B6B;
    font-size: 11px;
    font-weight: 500;
    padding: 0 0 0 2px;
}

QFrame#ChangeFileListFrame {
    background: #FAFAF8;
    border: 1px solid #EBEBE8;
    border-radius: 10px;
}

QListWidget#ChangeFileList {
    background: transparent;
    border: none;
    padding: 0;
    outline: none;
    font-family: "Cascadia Code", "Cascadia Mono", Consolas, monospace;
    font-size: 12px;
    color: #1A1A1A;
}

QListWidget#ChangeFileList::item {
    padding: 4px 8px;
    margin: 0;
    border-radius: 6px;
}

QListWidget#ChangeFileList::item:selected {
    background: #E8E8E5;
    color: #1A1A1A;
}

QListWidget#ChangeFileList::item:hover {
    background: #F0F0EE;
}

QTextBrowser#InspectorView {
    background: #FFFFFF;
    color: #1A1A1A;
    border: 1px solid #EBEBE8;
    border-radius: 10px;
    font-family: "Cascadia Code", "Cascadia Mono", "Sarasa Mono SC", Consolas, monospace;
    font-size: 12px;
    padding: 0;
}

/* Composer — 浅色圆角输入条 */
#ComposerDock {
    background: #F7F7F5;
    border-top: none;
}

#ComposerBox {
    background: #FFFFFF;
    border: 1px solid #E0E0DC;
    border-radius: 16px;
}

#ComposerBox:focus-within {
    border-color: #C0C0BC;
}

#ComposerBox QTextEdit {
    border: none;
    background: transparent;
    padding: 4px 2px 2px 2px;
    color: #1A1A1A;
}

/* Composer 内模式胶囊（参照 Cursor） */
QToolButton#ModePill {
    background: #2C2C2C;
    border: 1px solid #3A3A3A;
    border-radius: 10px;
    padding: 1px 10px;
    color: #F2F2F2;
    font-size: 11px;
    font-weight: 600;
    min-height: 20px;
    max-height: 22px;
}

QToolButton#ModePill:hover {
    background: #3A3A3A;
    border-color: #4A4A4A;
}

QToolButton#ModePill:disabled {
    background: #E8E8E5;
    border-color: #E0E0DC;
    color: #A0A0A0;
}

QToolButton#ModePill::menu-indicator {
    image: none;
    width: 0;
}

/* Agent/Plan 上拉：透明窗 + 圆角面板（无黑方底） */
QFrame#ModePopup {
    background: transparent;
    border: none;
}

QFrame#ModePopupPanel {
    background: #2A2A2A;
    border: 1px solid #3C3C3C;
    border-radius: 12px;
}

QFrame#ModePopupItem {
    background: transparent;
    border: none;
    border-radius: 8px;
    min-height: 20px;
    max-height: 22px;
}

QFrame#ModePopupItem:hover {
    background: #3A3A3A;
}

QFrame#ModePopupItem[checked="true"] {
    background: #333333;
}

QLabel#ModePopupIcon {
    background: transparent;
    border: none;
    color: #F0F0F0;
    font-size: 11px;
    font-weight: 600;
    padding: 0;
    margin: 0;
    min-width: 14px;
    max-width: 14px;
    min-height: 14px;
    max-height: 14px;
}

QLabel#ModePopupLabel {
    background: transparent;
    border: none;
    color: #F0F0F0;
    font-size: 11px;
    padding: 0;
}

QLabel#ModePopupCheck {
    background: transparent;
    border: none;
    color: #F0F0F0;
    font-size: 11px;
    min-width: 12px;
    padding: 0;
}

QPushButton#SendCircle {
    background: #1A1A1A;
    color: #FFFFFF;
    border: none;
    border-radius: 14px;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
    padding: 0;
    font-size: 14px;
    font-weight: 700;
}

QPushButton#SendCircle:hover {
    background: #333333;
}

QPushButton#SendCircle:disabled {
    background: #C8C8C4;
    color: #F5F5F3;
}

#StatusLabel {
    color: #8A8A8A;
    font-size: 11px;
    padding: 2px 4px 0 4px;
}

#TodoBanner {
    background: #FFFFFF;
    border: 1px solid #E5E5E2;
    border-radius: 10px;
}

#TodoBanner QLabel {
    color: #6B6B6B;
    font-size: 12px;
}

QProgressBar {
    background: #E8E8E5;
    border: none;
    border-radius: 2px;
    height: 3px;
    max-height: 3px;
    color: transparent;
}

QProgressBar::chunk {
    background: #1A1A1A;
    border-radius: 2px;
}

#ActionStrip {
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #D0D0CC;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #B8B8B4;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QGroupBox {
    border: 1px solid #E5E5E2;
    border-radius: 10px;
    margin-top: 10px;
    padding: 12px 10px 10px 10px;
    background: #FFFFFF;
    font-weight: 600;
    color: #2A2A2A;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
    color: #6B6B6B;
}

QRadioButton, QCheckBox {
    color: #2A2A2A;
    spacing: 8px;
}

QMenu {
    background: #FFFFFF;
    border: 1px solid #E5E5E2;
    color: #1A1A1A;
}

QMenu::item {
    padding: 6px 24px;
}

QMenu::item:selected {
    background: #EBEBE8;
}

/* 应用内弹框（替代系统 QMessageBox） */
QDialog#AppDialog {
    background: #F7F7F5;
    border: 1px solid #E5E5E2;
    color: #1A1A1A;
}

QLabel#AppDialogTitle {
    background: transparent;
    border: none;
    color: #1A1A1A;
    font-size: 15px;
    font-weight: 600;
    padding: 0;
}

QLabel#AppDialogMessage {
    background: transparent;
    border: none;
    color: #5A5A56;
    font-size: 13px;
    padding: 0;
    line-height: 1.35;
}

QLabel#AppDialogIcon {
    background: #E8E8E5;
    border: none;
    border-radius: 14px;
    color: #3A3A36;
    font-size: 14px;
    font-weight: 700;
}

QLabel#AppDialogIcon[kind="warn"] {
    background: #FCEBEB;
    color: #A04040;
}

QLabel#AppDialogIcon[kind="question"] {
    background: #E8EEF8;
    color: #3B6EF5;
}

QLabel#AppDialogIcon[kind="info"] {
    background: #E8E8E5;
    color: #3A3A36;
}

QPushButton#DialogPrimaryButton {
    background: #1A1A1A;
    border: none;
    border-radius: 10px;
    color: #FFFFFF;
    padding: 7px 18px;
    font-size: 12px;
    font-weight: 600;
    min-height: 30px;
    min-width: 72px;
}

QPushButton#DialogPrimaryButton:hover {
    background: #2A2A2A;
}

QPushButton#DialogPrimaryButton:pressed {
    background: #111111;
}

QPushButton#DialogGhostButton {
    background: #FFFFFF;
    border: 1px solid #E0E0DC;
    border-radius: 10px;
    color: #3A3A36;
    padding: 7px 16px;
    font-size: 12px;
    font-weight: 600;
    min-height: 30px;
    min-width: 72px;
}

QPushButton#DialogGhostButton:hover {
    background: #EBEBE8;
    border-color: #D4D4D0;
}

QScrollArea#AskScroll {
    background: transparent;
    border: none;
}

QWidget#AskScrollHost {
    background: transparent;
}

QWidget#AskQuestionCard {
    background: #FFFFFF;
    border: 1px solid #EBEBE8;
    border-radius: 12px;
}

QLabel#AskQuestionTitle {
    background: transparent;
    border: none;
    color: #1A1A1A;
    font-size: 13px;
    font-weight: 600;
    padding: 0 0 2px 0;
}

QLabel#AskOtherLabel {
    background: transparent;
    border: none;
    color: #6B6B6B;
    font-size: 12px;
}

QLineEdit#AskCustomInput {
    background: #FAFAF8;
    border: 1px solid #E5E5E2;
    border-radius: 8px;
    padding: 6px 10px;
    color: #1A1A1A;
    font-size: 12px;
    min-height: 28px;
}

QLineEdit#AskCustomInput:focus {
    border-color: #C8C8C4;
    background: #FFFFFF;
}

QRadioButton#AskOption,
QCheckBox#AskOption {
    color: #2A2A2A;
    font-size: 12.5px;
    spacing: 8px;
    padding: 2px 0;
}
